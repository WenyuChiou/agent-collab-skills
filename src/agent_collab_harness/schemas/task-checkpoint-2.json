{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WenyuChiou/agent-collab-skills/blob/main/src/agent_collab_harness/schemas/task-checkpoint-2.json",
  "title": "GoalCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "goal_id", "slice_id", "task", "totals", "baseline", "usage", "accepted_evidence", "history", "next_step", "action_kind", "review_required", "requires_human", "source_sha256", "failure_history", "active_failure"],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"$ref": "#/$defs/text"},
    "goal_id": {"$ref": "#/$defs/text"},
    "slice_id": {"type": "integer", "minimum": 0},
    "task": {"$ref": "task-checkpoint-1.json"},
    "totals": {"$ref": "#/$defs/totals"},
    "baseline": {"$ref": "#/$defs/totals"},
    "usage": {"$ref": "#/$defs/usage"},
    "accepted_evidence": {"$ref": "#/$defs/evidence"},
    "history": {"type": "array", "items": {"$ref": "#/$defs/historyEvent"}},
    "next_step": {"type": "string"},
    "action_kind": {"enum": ["execute", "diagnose", "review", "wait"]},
    "review_required": {"type": "boolean"},
    "requires_human": {"type": "boolean"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "failure_history": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "active_failure": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableCount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "cost_microusd"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullableCount"},
        "cached_input_tokens": {"$ref": "#/$defs/nullableCount"},
        "output_tokens": {"$ref": "#/$defs/nullableCount"},
        "cost_microusd": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle", "tool_calls", "elapsed_seconds", "children_spawned", "input_tokens", "cached_input_tokens", "output_tokens", "cost_microusd"],
      "properties": {
        "cycle": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "children_spawned": {"type": "integer", "minimum": 0},
        "input_tokens": {"$ref": "#/$defs/nullableCount"},
        "cached_input_tokens": {"$ref": "#/$defs/nullableCount"},
        "output_tokens": {"$ref": "#/$defs/nullableCount"},
        "cost_microusd": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "historyEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_id", "request_id", "previous_sha256", "sha256", "totals", "task_sha256", "evidence_refs"],
      "properties": {
        "slice_id": {"type": "integer", "minimum": 0},
        "request_id": {"$ref": "#/$defs/text"},
        "previous_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "sha256": {"$ref": "#/$defs/hash"},
        "totals": {"$ref": "#/$defs/totals"},
        "task_sha256": {"$ref": "#/$defs/hash"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "input_sha256", "error_class", "attempts", "evidence_ref", "observed_evidence"],
      "properties": {
        "identity": {"$ref": "#/$defs/hash"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "error_class": {"$ref": "#/$defs/text"},
        "attempts": {"type": "integer", "minimum": 0},
        "evidence_ref": {"$ref": "#/$defs/text"},
        "observed_evidence": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
