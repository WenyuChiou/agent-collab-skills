schema_version: 2
round: 1
goal: "Refactor the auth package while preserving its public contract."
policy_ref: "${AGENT_COLLAB_POLICY}"
checkpoint_ref: ".coord/checkpoint_001.json"
created_at: "2026-08-31T00:00:00Z"
tasks:
  - id: T1
    role: reviewer
    slug: define-auth-contract
    task_packet: ".ai/task_001_define-auth-contract.md"
    description: "Identify compatibility constraints and explicit blockers."
    depends_on: []
    files_in_scope:
      - "src/auth/**"
      - "tests/auth/**"
    success_criteria:
      - "Produces an evidence-referenced compatibility decision."
  - id: T2
    role: delegated-executor
    slug: refactor-auth-provider
    task_packet: ".ai/task_002_refactor-auth-provider.md"
    description: "Implement the bounded refactor after T1."
    depends_on: [T1]
    files_in_scope:
      - "src/auth/**"
      - "tests/auth/**"
    success_criteria:
      - "python -m pytest tests/auth exits 0"
  - id: T3
    role: synthesizer
    slug: summarize-evidence
    task_packet: ".ai/task_003_summarize-evidence.md"
    description: "Structure completed prose and test evidence without tools."
    depends_on: [T1, T2]
    files_in_scope: []
    success_criteria:
      - "Preserves failed and missing inputs without coercing them to success."

# Numeric limits are intentionally absent. The policy reference is the only
# machine-readable budget source. .coord/ and .ai/ remain scratch unless an
# artifact is explicitly promoted by the project.
